<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_bg_hero"
    android:padding="24dp">


    <TextView
        android:id="@+id/txtLobbyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOBBY"
        android:textColor="@android:color/white"
        android:textSize="36sp"
        android:fontFamily="@font/bangers_regular"
        android:letterSpacing="0.06"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/txtLobbySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome To the world of Crew or Crook"
        android:textColor="#F7E74A"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_lightitalic"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/txtLobbyTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <ImageView
        android:id="@+id/btnHelp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/plus_circle_bg"
        android:src="@drawable/ic_help"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="@id/txtLobbyTitle"
        app:layout_constraintBottom_toBottomOf="@id/txtLobbySubtitle"
        app:layout_constraintEnd_toEndOf="parent" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardRoomCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_translucent_dark"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtLobbySubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/lblRoomCodeHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Code"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvRoomCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="COSMIC42"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/lblRoomCodeHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCopyCode"
            app:layout_constraintBottom_toBottomOf="parent" />


        <ImageView
            android:id="@+id/btnCopyCode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/copy_btn_bg"
            android:src="@drawable/ic_copy"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            android:outlineSpotShadowColor="#FF0077"
            android:outlineAmbientShadowColor="#9E00D9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/imgUsersIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_users"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardRoomCode"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPlayerCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(1/6)"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/imgUsersIcon"
        app:layout_constraintBottom_toBottomOf="@id/imgUsersIcon"
        app:layout_constraintStart_toEndOf="@id/imgUsersIcon" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlayers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgUsersIcon"
        app:layout_constraintBottom_toTopOf="@id/btnStartGame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartGame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="START GAME"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/btn_gradient"
        app:backgroundTint="@null"
        android:paddingVertical="14dp"
        android:elevation="12dp"
        android:stateListAnimator="@null"
        android:outlineSpotShadowColor="#FF0077"
        android:outlineAmbientShadowColor="#9E00D9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutRulesPopup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/card_translucent_dark"
            android:padding="20dp"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtRulesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How to Play"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />


            <ImageView
                android:id="@+id/btnDismissRules"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <LinearLayout
                android:id="@+id/layoutRule1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/txtRulesTitle">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/avatar_pink_bg"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wait for all players to join the room using the room code."
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutRule2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layoutRule1">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/avatar_pink_bg"
                    android:text="2"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The host will start the game when everyone is ready."
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRule3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layoutRule2">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/avatar_pink_bg"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Players will be assigned roles: Crew or Crook."
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutRule4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layoutRule3">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/avatar_pink_bg"
                    android:text="4"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complete tasks and find the crook among you!"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp" />

            </LinearLayout>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGotIt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Got it!"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_gradient"
                app:backgroundTint="@null"
                android:elevation="8dp"
                android:stateListAnimator="@null"
                android:outlineSpotShadowColor="#FF0077"
                android:outlineAmbientShadowColor="#9E00D9"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/layoutRule4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>